# Copy to ford-ai-service/.env for local execution. Never commit the copied file.

# Application persistence
FORD_DATABASE_URL=jdbc:postgresql://postgres:5432/ford_service
FORD_DATABASE_USERNAME=ford
FORD_DATABASE_PASSWORD=change-me-local

# API authentication. Keep disabled for local webhook-only development.
# Production enables JWT and requires an OIDC issuer that publishes JWKS.
FORD_SECURITY_JWT_ENABLED=false
FORD_SECURITY_ISSUER_URI=
FORD_SECURITY_AUDIENCE=ford-ai-service

# Set false while testing bot-only behavior; production defaults to true.
FORD_HUMAN_HANDOFF_ENABLED=true

# Durable conversation memory. PostgreSQL is the source of truth.
FORD_MEMORY_ENABLED=true
FORD_MEMORY_RECENT_MESSAGE_LIMIT=20
FORD_MEMORY_PROMPT_RECENT_MESSAGE_LIMIT=8
FORD_MEMORY_SUMMARY_MAX_CHARS=4000
FORD_CONVERSATION_GRAPH_ENABLED=true
FORD_CONVERSATION_TURN_CONCURRENCY=1
FORD_CONVERSATION_TURN_QUEUE_CAPACITY=8
FORD_CONVERSATION_PUBLICATION_RETRY_AGE=PT1M
FORD_MEMORY_FACT_LIMIT=12
FORD_MEMORY_FACT_MAX_CHARS=500
# Semantic fact retrieval is opt-in and requires a compatible embedding model.
FORD_MEMORY_SEMANTIC_ENABLED=false
FORD_MEMORY_SEMANTIC_LIMIT=5
FORD_MEMORY_CACHE_ENABLED=false
FORD_MEMORY_CACHE_TTL=PT24H

# Model profile: deepseek (default) or local (Qwen on Ollama).
# OpenRouter is the only automatic fallback for either profile.
# Local Spring AI provider. Run Ollama on the host with:
#   ollama pull qwen3.5:4b
#   ollama pull nomic-embed-text
FORD_AI_MODEL_PROFILE=deepseek
FORD_AI_MAX_OUTPUT_TOKENS=1024
FORD_AI_LOCAL_ENABLED=true
FORD_AI_LOG_PROVIDER_ERRORS=false
# Customer media remains disabled until provider approval and capability are configured.
FORD_AI_MEDIA_ENABLED=false
FORD_AI_MEDIA_MAX_BYTES=10485760
FORD_AI_MEDIA_TIMEOUT=8s
FORD_AI_LOCAL_BASE_URL=http://127.0.0.1:11434
FORD_AI_LOCAL_BASE_URL_DOCKER=http://host.docker.internal:11434
FORD_AI_LOCAL_MODEL_VERSION=qwen3.5:4b
FORD_AI_LOCAL_TEMPERATURE=0.1
FORD_AI_EMBEDDING_PROVIDER=ollama
FORD_AI_EMBEDDING_MODEL_VERSION=nomic-embed-text

# DeepSeek is the primary cloud chat model; the local model is the recovery option.
FORD_AI_CLOUD_ENABLED=true
FORD_AI_CLOUD_PROVIDER=deepseek
FORD_DEEPSEEK_BASE_URL=https://api.deepseek.com
FORD_DEEPSEEK_MODEL=deepseek-flash
FORD_DEEPSEEK_API_KEY=replace-with-secret
FORD_AI_CLASSIFICATION_PII_POLICY=allow
FORD_AI_CLOUD_TEMPERATURE=0.1
# Optional cloud fallbacks. Keep disabled until their tool and structured-output
# behavior has passed `mise run test:ai-evaluation` with this application's evals.
FORD_AI_PROVIDER_MAX_ATTEMPTS=2
FORD_AI_PROVIDER_MAX_RETRY_AFTER=PT3S
FORD_AI_FALLBACK_ORDER=openrouter
FORD_AI_EVALUATION_MODE=false
FORD_AI_GROQ_ENABLED=false
FORD_AI_GROQ_MODEL=openai/gpt-oss-20b
FORD_AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
FORD_AI_GROQ_TOOL_CALLING_VERIFIED=false
FORD_AI_GROQ_STRUCTURED_OUTPUT_VERIFIED=false
GROQ_API_KEY=
FORD_AI_GEMINI_ENABLED=false
FORD_AI_GEMINI_MODEL=gemini-3.8-flash
FORD_AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FORD_AI_GEMINI_TOOL_CALLING_VERIFIED=false
FORD_AI_GEMINI_STRUCTURED_OUTPUT_VERIFIED=false
GEMINI_API_KEY=
FORD_AI_CLOUDFLARE_ENABLED=false
FORD_AI_CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
FORD_AI_CLOUDFLARE_TOOL_CALLING_VERIFIED=false
FORD_AI_CLOUDFLARE_STRUCTURED_OUTPUT_VERIFIED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
FORD_AI_OPENROUTER_ENABLED=true
FORD_AI_OPENROUTER_MODEL=xiaomi/mimo-v2.6-flash
FORD_AI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FORD_AI_OPENROUTER_TOOL_CALLING_VERIFIED=true
FORD_AI_OPENROUTER_STRUCTURED_OUTPUT_VERIFIED=true
OPENROUTER_API_KEY=

# Ford MCP is the authoritative source for volatile vehicle, catalog, and offer information.
# Keep disabled until the MCP server URL and bearer token are available.
FORD_MCP_ENABLED=false
FORD_MCP_URL=http://127.0.0.1:3001
FORD_MCP_ENDPOINT=/mcp
FORD_MCP_TOKEN=replace-with-mcp-http-bearer-token
FORD_MCP_REQUEST_TIMEOUT=30s
FORD_MCP_REQUIRED_FOR_VOLATILE_INFORMATION=true
FORD_MCP_READ_ONLY_TOOL_NAMES=search_vehicles,get_vehicle,compare_vehicles,search_offers,list_promotions,get_vehicle_provenance,get_catalog_status

# TypeSafe/Jev structured classification. Set TYPESAFE_API_KEY in private local config;
# missing/invalid key keeps deterministic rules active. PII pass-through is enabled for model requests.
FORD_AI_CLASSIFICATION_ENABLED=true
FORD_AI_CLASSIFICATION_MODE=active
FORD_AI_CLASSIFICATION_PROVIDER=typesafe
FORD_AI_CLASSIFICATION_TIMEOUT_MS=1500
FORD_AI_CLASSIFICATION_MIN_CONFIDENCE=0.70
FORD_AI_CLASSIFICATION_FALLBACK=rules
FORD_AI_CLASSIFIER_INTENT_ENABLED=true
FORD_AI_CLASSIFIER_LEAD_ENABLED=true
FORD_AI_CLASSIFIER_HANDOFF_ENABLED=true
FORD_AI_CLASSIFIER_TOOLS_ENABLED=true
FORD_AI_CLASSIFIER_SENSITIVE_DATA_ENABLED=false
FORD_AI_GUARDRAILS_ENABLED=false
FORD_AI_SELF_REFINE_ENABLED=false
FORD_AI_SELF_REFINE_MAX_ATTEMPTS=1

# Meta verification and inbound binding setup
FORD_META_VERIFY_TOKEN=replace-with-random-verification-token
FORD_META_APP_SECRET=replace-with-meta-app-secret
# In dev, recreate the default WhatsApp binding automatically after db:reset.
# Set false when managing channel_binding rows manually or using multiple numbers.
FORD_META_AUTO_BINDING_ENABLED=true

# Meta outbound delivery. Enable only after endpoint and token values exist.
FORD_META_DELIVERY_ENABLED=false
FORD_META_WHATSAPP_DELIVERY_ENDPOINT=https://graph.facebook.com/vXX.X/PHONE_NUMBER_ID/messages
FORD_META_WHATSAPP_ACCESS_TOKEN=replace-with-secret
FORD_CHANNELS_META_MEDIA_GRAPH_API_VERSION=
FORD_META_WABA_ID=replace-with-whatsapp-business-account-id
FORD_META_PHONE_ID=replace-with-phone-number-id
# Preferred explicit names for deployment configuration.
FORD_META_WHATSAPP_BUSINESS_ACCOUNT_ID=replace-with-whatsapp-business-account-id
FORD_META_PHONE_NUMBER_ID=replace-with-phone-number-id
FORD_META_PHONE_NUMBER=+52 13351264338
# Includes sanitized provider stack traces; enable only in development.
FORD_META_DIAGNOSTIC_STACKTRACES_ENABLED=false
# Optional; defaults to FORD_META_PHONE_ID.
# FORD_META_PROVIDER_ACCOUNT_ID=replace-with-phone-number-id
# Messenger and Instagram auto-bindings are opt-in and use provider Page/account IDs.
FORD_META_MESSENGER_AUTO_BINDING_ENABLED=false
FORD_META_MESSENGER_PAGE_ID=
FORD_META_INSTAGRAM_AUTO_BINDING_ENABLED=false
FORD_META_INSTAGRAM_ACCOUNT_ID=
FORD_META_MESSENGER_DELIVERY_ENDPOINT=
FORD_META_MESSENGER_ACCESS_TOKEN=
FORD_META_INSTAGRAM_DELIVERY_ENDPOINT=
FORD_META_INSTAGRAM_ACCESS_TOKEN=

# Canonical Ford ingestion. Keep disabled until an official or authorized source is available.
FORD_INGESTION_ENABLED=false
FORD_TENANT_ID=00000000-0000-0000-0000-000000000001
FORD_CATALOG_ENDPOINT=
FORD_INVENTORY_ENDPOINT=
FORD_SCRAPER_ENDPOINT=
FORD_MANUAL_CSV_PATH=

# External outbox delivery
FORD_OUTBOX_ENABLED=false

# Local telemetry
FORD_OTEL_TRACES_EXPORT_ENABLED=false
FORD_OTEL_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
FORD_OTEL_TRACES_ENDPOINT_DOCKER=http://host.docker.internal:4318/v1/traces
FORD_OTEL_SAMPLING_PROBABILITY=0.1
