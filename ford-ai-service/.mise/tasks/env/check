#!/usr/bin/env bash
#MISE description="Validate the selected environment contract without printing values"
set -euo pipefail

profile="${FORD_RUNTIME_ENV:-development}"
if [[ "$profile" == "development" ]]; then
  [[ -f "$MISE_PROJECT_ROOT/.env" ]] || {
    echo "Missing $MISE_PROJECT_ROOT/.env; copy .env.example first." >&2
    exit 1
  }
  if [[ "$(uname -s)" == "Linux" ]]; then
    for name in FORD_AI_LOCAL_BASE_URL FORD_OTEL_TRACES_ENDPOINT; do
      if [[ "${!name:-}" == *host.docker.internal* ]]; then
        printf '%s points to a Docker-only hostname on Linux host mode; use 127.0.0.1 or set the *_DOCKER variant for Compose.\n' "$name" >&2
        exit 1
      fi
    done
  fi
  if [[ "${FORD_AI_CLOUD_ENABLED:-false}" == "true" ]]; then
    cloud_base_url="${FORD_AI_CLOUD_BASE_URL:-}"
    if [[ "${FORD_AI_CLOUD_PROVIDER:-deepseek}" == "deepseek" ]]; then
      [[ "$cloud_base_url" == https://api.deepseek.com || "$cloud_base_url" == https://api.deepseek.com/v1 ]] || {
        printf 'FORD_AI_CLOUD_BASE_URL must use the approved DeepSeek API endpoint.\n' >&2
        exit 1
      }
    else
      case "$cloud_base_url" in
        */v1|*/v1/) ;;
        *)
          printf 'FORD_AI_CLOUD_BASE_URL must include the provider API version (expected a /v1 suffix) when cloud AI is enabled.\n' >&2
          exit 1
          ;;
      esac
    fi
  fi
elif [[ "$profile" == "production" ]]; then
  missing=()
  for name in FORD_DATABASE_URL FORD_DATABASE_USERNAME FORD_DATABASE_PASSWORD; do
    [[ -n "${!name:-}" ]] || missing+=("$name")
  done
  if ((${#missing[@]} > 0)); then
    printf 'Missing required production variables: %s\n' "${missing[*]}" >&2
    exit 1
  fi
else
  printf 'Unsupported FORD_RUNTIME_ENV: %s\n' "$profile" >&2
  exit 1
fi

printf 'Environment contract present: %s\n' "$profile"
