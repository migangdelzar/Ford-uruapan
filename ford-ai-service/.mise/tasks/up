#!/usr/bin/env bash
#MISE description="Build and start the application and observability stack"

set -euo pipefail

cd "$MISE_PROJECT_ROOT"
source "$MISE_PROJECT_ROOT/.mise/lib/compose.sh"
ensure_local_env
ford_compose config --quiet
ford_compose up -d --build
echo "Ford service stack started. Run 'mise run health' to check readiness."
