#!/usr/bin/env bash
#MISE description="Deploy Ford Service to the selected dev or prod environment"
set -euo pipefail
case "${FORD_RUNTIME_ENV:-}" in
  development)
    exec mise -E dev run container:up "$@"
    ;;
  production)
    ;;
  *)
    echo "Select the dev or prod mise environment before deploying Ford Service." >&2
    exit 2
    ;;
  esac
image="${EMME_APP_IMAGE:-}"
if [[ "${1:-}" == ghcr.io/* ]]; then
  image="$1"
  shift
fi
if [[ -n "$image" && ! "$image" =~ ^ghcr\.io/[A-Za-z0-9._/-]+@sha256:[a-f0-9]{64}$ ]]; then
  echo "Production Ford Service deployment requires an immutable GHCR image digest." >&2
  exit 2
fi
cd "$MISE_PROJECT_ROOT"
source "$MISE_PROJECT_ROOT/.mise/lib/remote.sh"
load_deploy_config
require_deploy_config
image="${image:-${EMME_APP_IMAGE:-ford-service:deployment}}"
if [[ ! "$image" =~ ^ghcr\.io/[A-Za-z0-9._/-]+@sha256:[a-f0-9]{64}$ ]]; then
  echo "Production Ford Service deployment requires an immutable GHCR image digest." >&2
  exit 2
fi
render_deploy_inventory

ansible_command "$(deploy_repo_root)/deployment/ansible/site.yml" \
  --tags common,app,verify --limit app \
  -e "app_image=$image" \
  "$@"
