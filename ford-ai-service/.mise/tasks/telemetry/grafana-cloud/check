#!/usr/bin/env bash
#MISE description="Check Grafana Cloud telemetry Collector health"

set -euo pipefail

cd "$MISE_PROJECT_ROOT"
source "$MISE_PROJECT_ROOT/.mise/lib/compose.sh"
require_command curl
require_langfuse_env
require_grafana_cloud_env
require_service_running otel-collector
wait_for_url "OpenTelemetry Collector" "http://localhost:${OTEL_HEALTH_PORT:-13133}/"
echo "Grafana Cloud telemetry Collector is ready."
