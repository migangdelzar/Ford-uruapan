#!/usr/bin/env bash
#MISE description="Run unit and integration tests"

set -euo pipefail

cd "$MISE_PROJECT_ROOT"

colima_socket="${HOME}/.colima/default/docker.sock"
if [[ -z "${DOCKER_HOST:-}" && -S "$colima_socket" ]]; then
  export DOCKER_HOST="unix://${colima_socket}"
fi

if [[ "${DOCKER_HOST:-}" == unix://*colima/* ]]; then
  # Ryuk cannot mount Colima's macOS socket path into a Linux container.
  export TESTCONTAINERS_RYUK_DISABLED="${TESTCONTAINERS_RYUK_DISABLED:-true}"
  unset TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE
fi

mise exec -- ./gradlew test integrationTest --no-scan
