#!/usr/bin/env bash
#MISE description="Start the complete local stack, including Grafana"

set -euo pipefail

cd "$MISE_PROJECT_ROOT"
source "$MISE_PROJECT_ROOT/.mise/lib/compose.sh"
ensure_local_env
ford_compose config --quiet
mise run deps:start
mise run telemetry:start
mise run container:app:rebuild
ford_compose --profile ui up -d grafana
