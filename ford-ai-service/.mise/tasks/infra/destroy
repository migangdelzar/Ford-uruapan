#!/usr/bin/env bash
#MISE description="Destroy non-data Terraform resources after confirmation"
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
source "$MISE_PROJECT_ROOT/.mise/lib/remote.sh"
load_deploy_config
[[ "${1:-}" == "--confirm" && "${2:-}" == "DESTROY-INFRA" ]] || { echo 'Usage: mise run infra:destroy -- --confirm DESTROY-INFRA' >&2; exit 2; }
terraform -chdir="$(deploy_repo_root)/deployment/terraform" plan -destroy -out="$(infra_state_dir)/destroy.tfplan"
if terraform -chdir="$(deploy_repo_root)/deployment/terraform" show -no-color "$(infra_state_dir)/destroy.tfplan" | rg -q 'oci_core_volume\.data|oci_objectstorage_bucket\.backups'; then
  echo 'Refusing destroy plan containing protected data resources.' >&2
  exit 1
fi
terraform -chdir="$(deploy_repo_root)/deployment/terraform" apply "$(infra_state_dir)/destroy.tfplan"
