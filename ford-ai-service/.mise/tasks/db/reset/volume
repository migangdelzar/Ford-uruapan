#!/usr/bin/env bash
#MISE description="Delete local PostgreSQL volumes and recreate dependency containers"
set -euo pipefail

cd "$MISE_PROJECT_ROOT"
source "$MISE_PROJECT_ROOT/.mise/lib/compose.sh"

if [[ $# -ne 1 || "$1" != "--confirm" ]]; then
  echo "Refusing to delete Docker volumes. Usage: mise run db:reset:volume -- --confirm" >&2
  exit 2
fi

ford_compose down --volumes --remove-orphans
ford_compose up -d postgres redis

echo "PostgreSQL volume deleted and fresh PostgreSQL/Redis containers started."
echo "Start the application to let Liquibase recreate the schema: mise run app:run"
