#!/usr/bin/env bash
#MISE description="Start the core stack plus the optional Grafana UI"

set -euo pipefail

cd "$MISE_PROJECT_ROOT"
source "$MISE_PROJECT_ROOT/.mise/lib/compose.sh"
ensure_local_env
ford_compose config --quiet
ford_compose --profile ui up -d --build
echo "Ford service stack and Grafana UI started. Run 'mise run health-ui' to check readiness."
