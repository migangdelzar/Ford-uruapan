#!/usr/bin/env bash
#MISE description="Show remote app or data logs"
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
source "$MISE_PROJECT_ROOT/.mise/lib/remote.sh"
load_deploy_config
require_deploy_config
render_deploy_inventory
role="${1:-app}"
if (( $# > 0 )); then
  shift
fi
case "$role" in
  app) limit=app; project='app';;
  data) limit=data; project='data';;
  *) echo "Usage: mise run deploy:logs -- app|data" >&2; exit 2;;
esac
ansible_args=("$limit")
[[ "$role" == data ]] && ansible_args+=(-b)
ANSIBLE_CONFIG="$(deploy_repo_root)/deployment/ansible/ansible.cfg" ansible "${ansible_args[@]}" -i "$(deploy_inventory_file)" -m shell -a "docker compose -f '$EMME_REMOTE_ROOT/$project/compose.yml' logs --tail=100" "$@"
