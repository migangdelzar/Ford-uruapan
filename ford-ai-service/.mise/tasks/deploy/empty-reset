#!/usr/bin/env bash
#MISE description="Guarded full-empty reset of Ford data directories on emme-2"
set -euo pipefail
if [[ "${FORD_RUNTIME_ENV:-}" != "production" ]]; then
  echo "Select the prod mise environment before the guarded reset." >&2
  exit 2
fi
[[ $# == 0 ]] || {
  echo 'Usage: export FORD_EMPTY_RESET_APPROVAL_ID and FORD_EMPTY_RESET_BACKUP_MANIFEST_SHA256, then run mise -E prod run deploy:empty-reset' >&2
  exit 2
}
approval_id="${FORD_EMPTY_RESET_APPROVAL_ID:-}"
manifest_sha256="${FORD_EMPTY_RESET_BACKUP_MANIFEST_SHA256:-}"
[[ "$approval_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$ && "$manifest_sha256" =~ ^[a-f0-9]{64}$ ]] || {
  echo "Required reset approval ID or backup manifest SHA-256 is missing or invalid." >&2
  exit 2
}
cd "$MISE_PROJECT_ROOT"
source "$MISE_PROJECT_ROOT/.mise/lib/remote.sh"
load_deploy_config
require_deploy_config
render_deploy_inventory
ansible_command "$(deploy_repo_root)/deployment/ansible/ford-empty-reset.yml" \
  --limit data \
  -e ford_empty_reset_approved=true \
  -e "ford_empty_reset_approval_id=$approval_id" \
  -e "ford_empty_reset_backup_manifest_sha256=$manifest_sha256"
