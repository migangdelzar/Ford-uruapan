#!/usr/bin/env bash
#MISE description="Configure Docker prerequisites on both EMME VMs"
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
source "$MISE_PROJECT_ROOT/.mise/lib/remote.sh"
