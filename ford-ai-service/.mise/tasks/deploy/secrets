#!/usr/bin/env bash
#MISE description="Show the secure credential provisioning commands"
set -euo pipefail

cat >&2 <<'MESSAGE'
This legacy task is disabled because it stored credential values in deployment/config/oci.env.

For a newly issued production credential, use:
  mise run deploy:vault-secret -- create PROPERTY

To update an existing OCI Vault secret version, use:
  mise run deploy:vault-secret -- rotate PROPERTY SECRET_OCID

For local-only development credentials, add a Generic Password in macOS Keychain
and run the local command through scripts/with-keychain-secrets.sh.
MESSAGE
exit 2
