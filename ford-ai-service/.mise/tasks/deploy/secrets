#!/usr/bin/env bash
#MISE description="Collect and generate local deployment secrets without printing them"
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
source "$MISE_PROJECT_ROOT/.mise/lib/remote.sh"
load_deploy_config
for name in POSTGRES_PASSWORD REDIS_PASSWORD FORD_OPERATOR_PASSWORD \
  FORD_META_APP_SECRET FORD_META_VERIFY_TOKEN FORD_META_WHATSAPP_ACCESS_TOKEN \
  GHCR_USERNAME GHCR_TOKEN OPENAI_API_KEY \
  FORD_RESEND_API_KEY \
  GROQ_API_KEY GEMINI_API_KEY CLOUDFLARE_API_TOKEN CLOUDFLARE_ACCOUNT_ID OPENROUTER_API_KEY \
  TYPESAFE_API_KEY; do
  adopt_environment_secret "$name"
done
adopt_environment_secret TYPESAFE_API_KEY FORD_TYPESAFE_JEV_API_KEY
if [[ -n "${FORD_DEEPSEEK_API_KEY:-}" ]]; then
  set_deploy_secret OPENAI_API_KEY "$FORD_DEEPSEEK_API_KEY"
fi
for name in \
  FORD_MCP_TOKEN FORD_MCP_API_TOKEN MCP_HTTP_BEARER_TOKEN GRAFANA_CLOUD_API_TOKEN LANGFUSE_SECRET_KEY \
  OCI_OBJECT_STORAGE_NAMESPACE; do
  adopt_environment_secret "$name"
done
ensure_deploy_secret POSTGRES_PASSWORD
ensure_deploy_secret REDIS_PASSWORD
ensure_deploy_secret FORD_OPERATOR_PASSWORD
ensure_deploy_secret FORD_BFF_OIDC_CLIENT_SECRET
config_file="$(deploy_config_file)"
if ! grep -q '^FORD_SECURITY_JWK_PRIVATE_KEY=.' "$config_file"; then
  key_file="$(mktemp)"
  trap 'rm -f "$key_file"' EXIT
  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
    | openssl pkcs8 -topk8 -nocrypt -outform DER > "$key_file"
  key_base64="$(base64 < "$key_file" | tr -d '\n')"
  set_deploy_secret FORD_SECURITY_JWK_PRIVATE_KEY "$key_base64"
  unset key_base64
  rm -f "$key_file"
  trap - EXIT
fi
prompt_deploy_secret FORD_META_APP_SECRET "Meta app secret"
prompt_deploy_secret FORD_META_VERIFY_TOKEN "Meta webhook verify token"
prompt_deploy_secret FORD_META_WHATSAPP_ACCESS_TOKEN "Meta WhatsApp access token"
prompt_deploy_secret GRAFANA_CLOUD_API_TOKEN "Grafana Cloud API token"
prompt_deploy_secret LANGFUSE_SECRET_KEY "Langfuse secret key"
chmod 600 "$(deploy_config_file)"
echo "Deployment secrets are present in the ignored local config file; deploy:app will propagate them through Ansible."
