#!/usr/bin/env bash
#MISE description="Create or rotate a secret in OCI Vault without writing its value to disk"
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
source "$MISE_PROJECT_ROOT/.mise/lib/remote.sh"

clear_loaded_secret_environment() {
  unset POSTGRES_PASSWORD REDIS_PASSWORD FORD_OPERATOR_PASSWORD FORD_SECURITY_JWK_PRIVATE_KEY \
    FORD_RESEND_API_KEY FORD_META_APP_SECRET FORD_META_VERIFY_TOKEN FORD_META_WHATSAPP_ACCESS_TOKEN \
    FORD_META_MESSENGER_ACCESS_TOKEN FORD_META_INSTAGRAM_ACCESS_TOKEN \
    FORD_AI_OLLAMA_ACCESS_CLIENT_SECRET \
    GROQ_API_KEY GEMINI_API_KEY CLOUDFLARE_API_TOKEN OPENROUTER_API_KEY OPENAI_API_KEY \
    TYPESAFE_API_KEY FORD_TYPESAFE_API_KEY FORD_TYPESAFE_JEV_API_KEY GHCR_TOKEN \
    GRAFANA_CLOUD_API_TOKEN LANGFUSE_SECRET_KEY
}

operation="${1:-}"
property="${2:-}"
existing_secret_id="${3:-}"
source_name_for_test_property() {
  case "$1" in
    FORD_DATABASE_PASSWORD) source_name=POSTGRES_PASSWORD ;;
    SPRING_DATA_REDIS_PASSWORD) source_name=REDIS_PASSWORD ;;
    FORD_OPERATOR_PASSWORD|FORD_SECURITY_JWK_PRIVATE_KEY|FORD_RESEND_API_KEY|\
      FORD_META_APP_SECRET|FORD_META_VERIFY_TOKEN|FORD_META_WHATSAPP_ACCESS_TOKEN|\
      FORD_META_MESSENGER_ACCESS_TOKEN|FORD_META_INSTAGRAM_ACCESS_TOKEN|\
      FORD_AI_OLLAMA_ACCESS_CLIENT_SECRET|\
      GROQ_API_KEY|GEMINI_API_KEY|CLOUDFLARE_API_TOKEN|OPENROUTER_API_KEY|\
      OPENAI_API_KEY|GHCR_TOKEN|GRAFANA_CLOUD_API_TOKEN|LANGFUSE_SECRET_KEY) source_name="$1" ;;
    TYPESAFE_API_KEY)
      if [[ -n "${TYPESAFE_API_KEY:-}" ]]; then
        source_name=TYPESAFE_API_KEY
      else
        source_name=FORD_TYPESAFE_JEV_API_KEY
      fi
      ;;
    *) return 1 ;;
  esac
}

import_current_test_secret() {
  local import_property="$1" source_name secret_value mapping_name secret_name secret_id
  local configured_region="${OCI_REGION:-us-ashburn-1}" configured_profile="${OCI_CONFIG_PROFILE:-DEFAULT}"
  local configured_compartment="${OCI_COMPARTMENT_OCID:-}" configured_vault="${OCI_VAULT_ID:-}"
  local configured_key="${OCI_VAULT_KEY_ID:-}"
  load_deploy_config
  export OCI_REGION="${configured_region:-${OCI_REGION:-us-ashburn-1}}"
  export OCI_CONFIG_PROFILE="${configured_profile:-${OCI_CONFIG_PROFILE:-DEFAULT}}"
  [[ -n "$configured_compartment" ]] && export OCI_COMPARTMENT_OCID="$configured_compartment"
  [[ -n "$configured_vault" ]] && export OCI_VAULT_ID="$configured_vault"
  [[ -n "$configured_key" ]] && export OCI_VAULT_KEY_ID="$configured_key"
  source_name=""
  source_name_for_test_property "$import_property" || {
    echo "Property is not allowlisted for test import: ${import_property}" >&2
    return 2
  }
  unset secret_value
  secret_value="${!source_name:-}"
  clear_loaded_secret_environment
  if [[ -z "$secret_value" ]]; then
    echo "Skipped ${import_property}: no current value is configured."
    return 0
  fi

  mapping_name="FORD_VAULT_SECRET_OCID_${import_property}"
  secret_name="ford-test-$(printf '%s' "$import_property" | tr '[:upper:]_' '[:lower:]-' | tr -s '-')"
  mapping_file="$(deploy_repo_root)/deployment/config/vault-test-secret-ocids.env"
  if [[ -L "$mapping_file" ]]; then
    echo "Test Vault OCID mapping file must not be a symlink." >&2
    return 1
  fi
  if [[ -f "$mapping_file" ]] && awk -F= -v name="$mapping_name" '$1 == name { found=1 } END { exit !found }' "$mapping_file"; then
    unset secret_value
    echo "Skipped ${import_property}: test Vault mapping already exists."
    return 0
  fi

  # Keep the current value only in this shell variable; child tools inherit
  # resource metadata but not the loaded credential environment.
  secret_id="$(printf '%s' "$secret_value" \
    | python3 "$MISE_PROJECT_ROOT/scripts/oci/create_secret_request.py" create-test "$secret_name" \
    | oci vault secret create-base64 \
      --from-json file:///dev/stdin \
      --auth security_token \
      --profile "$OCI_CONFIG_PROFILE" \
      --region "$OCI_REGION" \
      --wait-for-state ACTIVE \
      --wait-interval-seconds 5 \
      --query 'data.id' \
      --raw-output)"
  unset secret_value
  if ! python3 "$MISE_PROJECT_ROOT/scripts/oci/update_secret_mapping.py" \
    "$mapping_file" "$mapping_name" "$secret_id"; then
    echo "OCI accepted ${import_property}, but its test mapping could not be saved." >&2
    echo "Secret OCID (non-secret metadata): ${secret_id}" >&2
    return 1
  fi
  echo "Imported current ${import_property} into a test-only Vault secret."
}

if [[ "$operation" == "import-current-test" ]]; then
  if (( $# != 1 )); then
    echo "Usage: mise run deploy:vault-secret -- import-current-test"
    exit 2
  fi
  for command_name in oci python3; do
    require_command "$command_name"
  done
  configured_region="${OCI_REGION:-us-ashburn-1}"
  configured_profile="${OCI_CONFIG_PROFILE:-DEFAULT}"
  configured_compartment="${OCI_COMPARTMENT_OCID:-}"
  configured_vault="${OCI_VAULT_ID:-}"
  configured_key="${OCI_VAULT_KEY_ID:-}"
  load_deploy_config
  export OCI_REGION="${configured_region:-${OCI_REGION:-us-ashburn-1}}"
  export OCI_CONFIG_PROFILE="${configured_profile:-${OCI_CONFIG_PROFILE:-DEFAULT}}"
  [[ -n "$configured_compartment" ]] && export OCI_COMPARTMENT_OCID="$configured_compartment"
  [[ -n "$configured_vault" ]] && export OCI_VAULT_ID="$configured_vault"
  [[ -n "$configured_key" ]] && export OCI_VAULT_KEY_ID="$configured_key"
  unset configured_region configured_profile configured_compartment configured_vault configured_key
  if [[ -z "${OCI_COMPARTMENT_OCID:-}" || -z "${OCI_VAULT_ID:-}" || -z "${OCI_VAULT_KEY_ID:-}" ]]; then
    echo "OCI compartment, vault, and key OCIDs must be configured for test import." >&2
    exit 2
  fi
  clear_loaded_secret_environment
  oci iam region list \
    --auth security_token \
    --profile "$OCI_CONFIG_PROFILE" \
    --region "$OCI_REGION" \
    --query 'data[0].name' \
    --raw-output >/dev/null
  for property in FORD_DATABASE_PASSWORD SPRING_DATA_REDIS_PASSWORD FORD_OPERATOR_PASSWORD \
    FORD_SECURITY_JWK_PRIVATE_KEY FORD_RESEND_API_KEY FORD_META_APP_SECRET FORD_META_VERIFY_TOKEN \
    FORD_META_WHATSAPP_ACCESS_TOKEN FORD_META_MESSENGER_ACCESS_TOKEN FORD_META_INSTAGRAM_ACCESS_TOKEN \
    FORD_AI_OLLAMA_ACCESS_CLIENT_SECRET GROQ_API_KEY \
    GEMINI_API_KEY CLOUDFLARE_API_TOKEN OPENROUTER_API_KEY TYPESAFE_API_KEY OPENAI_API_KEY \
    GHCR_TOKEN GRAFANA_CLOUD_API_TOKEN LANGFUSE_SECRET_KEY; do
    import_current_test_secret "$property"
  done
  exit 0
fi

if [[ "$operation" != "create" && "$operation" != "rotate" ]] \
  || [[ ! "$property" =~ ^[A-Z][A-Z0-9_]*$ ]] \
  || { [[ "$operation" == "create" ]] && (( $# != 2 )); } \
  || { [[ "$operation" == "rotate" ]] && (( $# != 3 )); }; then
  echo "Usage: mise run deploy:vault-secret -- create PROPERTY"
  echo "   or: mise run deploy:vault-secret -- rotate PROPERTY SECRET_OCID"
  exit 2
fi

mapping_name="FORD_VAULT_SECRET_OCID_${property}"
secret_name="ford-prod-$(printf '%s' "$property" | tr '[:upper:]_' '[:lower:]-' | tr -s '-')"
mapping_file="$(deploy_repo_root)/deployment/config/vault-secret-ocids.env"
load_vault_secret_mappings

if [[ "$operation" == "create" && -n "${!mapping_name:-}" ]]; then
  echo "A Vault mapping already exists for ${property}; use rotate with its secret OCID." >&2
  exit 2
fi
if [[ "$operation" == "rotate" ]]; then
  if [[ ! "$existing_secret_id" =~ ^ocid1\.vaultsecret\.oc1\.[a-z0-9-]*\.[A-Za-z0-9_-]+(\.[A-Za-z0-9_-]+)*$ ]]; then
    echo "A valid OCI Vault secret OCID is required for rotation." >&2
    exit 2
  fi
  if [[ -n "${!mapping_name:-}" && "${!mapping_name}" != "$existing_secret_id" ]]; then
    echo "The supplied secret OCID does not match the local mapping for ${property}." >&2
    exit 2
  fi
fi

for command_name in oci python3; do
  require_command "$command_name"
done

export OCI_REGION="${OCI_REGION:-us-ashburn-1}"
export OCI_CONFIG_PROFILE="${OCI_CONFIG_PROFILE:-DEFAULT}"
if [[ "$operation" == "create" ]]; then
  read -r -p "OCI compartment OCID (Enter to use configured value): " compartment_input
  read -r -p "OCI Vault OCID (Enter to use configured value): " vault_input
  read -r -p "OCI Vault key OCID (Enter to use configured value): " key_input
  OCI_COMPARTMENT_OCID="${compartment_input:-${OCI_COMPARTMENT_OCID:-}}"
  OCI_VAULT_ID="${vault_input:-${OCI_VAULT_ID:-}}"
  OCI_VAULT_KEY_ID="${key_input:-${OCI_VAULT_KEY_ID:-}}"
  unset compartment_input vault_input key_input
  if [[ -z "$OCI_COMPARTMENT_OCID" || -z "$OCI_VAULT_ID" || -z "$OCI_VAULT_KEY_ID" ]]; then
    echo "OCI compartment, vault, and key OCIDs are required." >&2
    exit 2
  fi
  export OCI_COMPARTMENT_OCID OCI_VAULT_ID OCI_VAULT_KEY_ID
fi

# Check the session before the hidden secret prompt; expired sessions can ask for
# interactive reauthentication and must not consume the secret input.
oci iam region list \
  --auth security_token \
  --profile "$OCI_CONFIG_PROFILE" \
  --region "$OCI_REGION" \
  --query 'data[0].name' \
  --raw-output >/dev/null

unset secret_value confirmation
secret_value=""
confirmation=""
trap 'unset secret_value confirmation' EXIT
read -r -s -p "Enter the newly issued value for ${property}: " secret_value
printf '\n'
read -r -s -p "Confirm the value: " confirmation
printf '\n'
if [[ -z "$secret_value" || "$secret_value" != "$confirmation" ]]; then
  echo "The values were empty or did not match; no Vault request was made." >&2
  exit 2
fi
unset confirmation

if [[ "$operation" == "create" ]]; then
  secret_id="$(printf '%s' "$secret_value" \
    | python3 "$MISE_PROJECT_ROOT/scripts/oci/create_secret_request.py" create "$secret_name" \
    | oci vault secret create-base64 \
      --from-json file:///dev/stdin \
      --auth security_token \
      --profile "$OCI_CONFIG_PROFILE" \
      --region "$OCI_REGION" \
      --wait-for-state ACTIVE \
      --wait-interval-seconds 5 \
      --query 'data.id' \
      --raw-output)"
else
  secret_id="$(printf '%s' "$secret_value" \
    | python3 "$MISE_PROJECT_ROOT/scripts/oci/create_secret_request.py" rotate "$secret_name" \
    | oci vault secret update-base64 \
      --secret-id "$existing_secret_id" \
      --from-json file:///dev/stdin \
      --force \
      --auth security_token \
      --profile "$OCI_CONFIG_PROFILE" \
      --region "$OCI_REGION" \
      --wait-for-state ACTIVE \
      --wait-interval-seconds 5 \
      --query 'data.id' \
      --raw-output)"
fi
unset secret_value

if ! python3 "$MISE_PROJECT_ROOT/scripts/oci/update_secret_mapping.py" \
  "$mapping_file" "$mapping_name" "$secret_id"; then
  echo "OCI accepted the secret operation, but the local OCID mapping was not updated." >&2
  echo "Record the returned secret OCID in the ignored mapping file before deployment: ${secret_id}" >&2
  exit 1
fi

echo "${property} stored in OCI Vault; only its OCID was written to ${mapping_file}."
