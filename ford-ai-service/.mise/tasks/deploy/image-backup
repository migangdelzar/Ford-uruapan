#!/usr/bin/env bash
#MISE description="Download the current emme-1 app image for rollback"
set -euo pipefail

cd "$MISE_PROJECT_ROOT"
source "$MISE_PROJECT_ROOT/.mise/lib/remote.sh"
load_deploy_config
require_command ssh
require_command gzip
ensure_deploy_state_dir

image="${1:-ford-service:deployment}"
[[ "$image" =~ ^[A-Za-z0-9._/@:-]+$ ]] || {
  echo "Invalid remote image reference." >&2
  exit 2
}

archive="$(deploy_state_dir)/emme-1-image-before-deploy.tar.gz"
key="${EMME_1_SSH_KEY:-${OCI_SSH_PRIVATE_KEY}}"
host="${OCI_SSH_USER}@${EMME_1_SSH_HOST}"
umask 077

ssh \
  -o BatchMode=yes \
  -o ConnectTimeout=10 \
  -o StrictHostKeyChecking=accept-new \
  -i "$key" \
  "$host" \
  "docker image inspect '$image' >/dev/null && docker save '$image' | gzip" \
  > "$archive"

printf 'Saved rollback image archive: %s\n' "$archive"
