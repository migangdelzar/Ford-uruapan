#!/usr/bin/env bash
#MISE description="Start databases and observability for a JVM running on the host"

set -euo pipefail

cd "$MISE_PROJECT_ROOT"
source "$MISE_PROJECT_ROOT/.mise/lib/compose.sh"
ensure_local_env
ford_compose up -d postgres redis prometheus loki tempo otel-collector alloy
echo "Host-side dependencies started. Run 'mise run app:run' for the local JVM."
