#!/usr/bin/env bash
#MISE description="List retained, verified database backup manifests on emme-2"
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
source "$MISE_PROJECT_ROOT/.mise/lib/remote.sh"
load_deploy_config
require_command ssh

missing=()
for name in OCI_SSH_USER EMME_2_SSH_HOST EMME_REMOTE_ROOT; do
  [[ -n "${!name:-}" ]] || missing+=("$name")
done
[[ -r "${EMME_2_SSH_KEY:-${OCI_SSH_PRIVATE_KEY:-}}" ]] || missing+=("readable:EMME_2_SSH_KEY")
(( ${#missing[@]} == 0 )) || {
  printf 'Missing backup listing configuration: %s\n' "${missing[*]}" >&2
  exit 1
}

remote_key="${EMME_2_SSH_KEY:-${OCI_SSH_PRIVATE_KEY}}"
remote_host="${OCI_SSH_USER}@${EMME_2_SSH_HOST}"
remote_archive="${EMME_REMOTE_ROOT}/backup/archive"
remote_command=(sudo find "$remote_archive" -maxdepth 1 -type f -name 'manifest_*.json' -printf '%f\n')
printf -v escaped_command '%q ' "${remote_command[@]}"
manifests="$(ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -i "$remote_key" \
  "$remote_host" "$escaped_command")"
if [[ -z "$manifests" ]]; then
  echo 'No completed backup manifests are retained on emme-2.'
  exit 0
fi
printf '%s\n' "$manifests" | sort
