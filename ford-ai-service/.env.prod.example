# Copy to .env.prod only for local production-like testing.
# Production deployments should inject these values from a secret manager or CI.
FORD_DATABASE_URL=jdbc:postgresql://db.example.invalid:5432/ford_service?ApplicationName=ford-service
FORD_DATABASE_USERNAME=ford_service
FORD_DATABASE_PASSWORD=replace-with-secret
FORD_REDIS_HOST=redis.example.invalid
FORD_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=replace-with-secret

# Spring Security OAuth2 Resource Server.
FORD_SECURITY_JWT_ENABLED=true
FORD_SECURITY_ISSUER_URI=https://identity.example.invalid/realms/ford
FORD_SECURITY_AUDIENCE=ford-ai-service

# Keep automatic binding disabled in production unless this deployment owns one
# default WhatsApp number and has an explicit tenant mapping.
FORD_META_AUTO_BINDING_ENABLED=false
FORD_META_PROVIDER_ACCOUNT_ID=replace-with-phone-number-id
FORD_META_PHONE_ID=replace-with-phone-number-id
FORD_META_PHONE_NUMBER_ID=replace-with-phone-number-id
FORD_META_WHATSAPP_BUSINESS_ACCOUNT_ID=replace-with-whatsapp-business-account-id
FORD_META_PHONE_NUMBER=+52 13351264338
FORD_META_DIAGNOSTIC_STACKTRACES_ENABLED=false
FORD_TENANT_ID=replace-with-tenant-uuid

# Choose explicitly for the deployment; do not inherit local bot-only mode.
FORD_HUMAN_HANDOFF_ENABLED=true

# PostgreSQL-backed durable conversation memory.
FORD_MEMORY_ENABLED=true
FORD_MEMORY_RECENT_MESSAGE_LIMIT=20
FORD_MEMORY_PROMPT_RECENT_MESSAGE_LIMIT=20
FORD_MEMORY_SUMMARY_MAX_CHARS=4000
FORD_CONVERSATION_GRAPH_ENABLED=true
FORD_CONVERSATION_TURN_CONCURRENCY=1
FORD_CONVERSATION_TURN_QUEUE_CAPACITY=8
FORD_CONVERSATION_PUBLICATION_RETRY_AGE=PT1M
FORD_MEMORY_FACT_LIMIT=12
FORD_MEMORY_FACT_MAX_CHARS=500
# Enable only after the embedding model dimension/provider is verified.
FORD_MEMORY_SEMANTIC_ENABLED=false
FORD_MEMORY_SEMANTIC_LIMIT=5
FORD_MEMORY_CACHE_ENABLED=true
FORD_MEMORY_CACHE_TTL=PT24H

FORD_AI_CHAT_PROVIDER=openai
FORD_AI_CLOUD_PROVIDER=openai
FORD_AI_CLOUD_ENABLED=true
FORD_AI_LOCAL_ENABLED=false
FORD_AI_CLOUD_BASE_URL=https://api.deepseek.com
FORD_AI_CLOUD_MODEL_VERSION=deepseek-flash
OPENAI_API_KEY=replace-with-secret
FORD_AI_LOCAL_BASE_URL=http://ollama.example.invalid:11434
FORD_AI_LOCAL_MODEL_VERSION=qwen3.5:4b
FORD_AI_LOCAL_TEMPERATURE=0.1
FORD_AI_CLOUD_TEMPERATURE=0.1
FORD_AI_EMBEDDING_MODEL_VERSION=nomic-embed-text
FORD_AI_PROVIDER_MAX_ATTEMPTS=2
FORD_AI_PROVIDER_MAX_RETRY_AFTER=PT3S
FORD_AI_FALLBACK_ORDER=openrouter
FORD_AI_EVALUATION_MODE=false
FORD_AI_GROQ_ENABLED=false
FORD_AI_GROQ_MODEL=openai/gpt-oss-20b
FORD_AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
FORD_AI_GROQ_TOOL_CALLING_VERIFIED=false
FORD_AI_GROQ_STRUCTURED_OUTPUT_VERIFIED=false
GROQ_API_KEY=
FORD_AI_GEMINI_ENABLED=false
FORD_AI_GEMINI_MODEL=gemini-3.8-flash
FORD_AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FORD_AI_GEMINI_TOOL_CALLING_VERIFIED=false
FORD_AI_GEMINI_STRUCTURED_OUTPUT_VERIFIED=false
GEMINI_API_KEY=
FORD_AI_CLOUDFLARE_ENABLED=false
FORD_AI_CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
FORD_AI_CLOUDFLARE_TOOL_CALLING_VERIFIED=false
FORD_AI_CLOUDFLARE_STRUCTURED_OUTPUT_VERIFIED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
FORD_AI_OPENROUTER_ENABLED=true
FORD_AI_OPENROUTER_MODEL=xiaomi/mimo-v2.6-flash
FORD_AI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FORD_AI_OPENROUTER_TOOL_CALLING_VERIFIED=false
FORD_AI_OPENROUTER_STRUCTURED_OUTPUT_VERIFIED=false
OPENROUTER_API_KEY=
FORD_MCP_ENABLED=false
FORD_MCP_URL=https://mcp.example.invalid
FORD_MCP_ENDPOINT=/mcp
FORD_MCP_TOKEN=replace-with-mcp-http-bearer-token
FORD_MCP_REQUEST_TIMEOUT=30s
FORD_MCP_REQUIRED_FOR_VOLATILE_INFORMATION=true
FORD_MCP_READ_ONLY_TOOL_NAMES=search_vehicles,get_vehicle,compare_vehicles,search_offers,list_promotions,get_vehicle_provenance,get_catalog_status
FORD_INGESTION_ENABLED=false
FORD_OUTBOX_ENABLED=false
FORD_OTEL_METRICS_EXPORT_ENABLED=true
FORD_OTEL_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics
FORD_OTEL_TRACES_EXPORT_ENABLED=true
FORD_OTEL_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces

# Jev lead/handoff classification. Provide TYPESAFE_API_KEY through private deployment config.
FORD_AI_CLASSIFICATION_ENABLED=true
FORD_AI_CLASSIFICATION_MODE=active
FORD_AI_CLASSIFICATION_PROVIDER=typesafe
FORD_AI_CLASSIFICATION_FALLBACK=rules
FORD_AI_CLASSIFIER_INTENT_ENABLED=true
FORD_AI_CLASSIFIER_LEAD_ENABLED=true
FORD_AI_CLASSIFIER_HANDOFF_ENABLED=true
FORD_AI_CLASSIFIER_TOOLS_ENABLED=true
FORD_AI_CLASSIFIER_SENSITIVE_DATA_ENABLED=false
