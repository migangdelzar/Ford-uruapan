#!/usr/bin/env bash
set -euo pipefail

archive_name="${1:-}"
container_name="${2:-}"
database_name="${3:-}"
if [[ ! "$archive_name" =~ ^[A-Za-z0-9._-]+\.dump\.gz$ ]]; then
  echo "Usage: restore-database.sh <archive-name.dump.gz> <isolated-container-name> <isolated-database-name>" >&2
  exit 2
fi
[[ "$container_name" =~ ^rehearsal-[A-Za-z0-9][A-Za-z0-9_.-]*$ && "$database_name" =~ ^[A-Za-z0-9_]+$ ]] || { echo "A rehearsal-prefixed isolated container and database name are required." >&2; exit 2; }
[[ "$database_name" != "ford_service" && "$database_name" != "ford" ]] || { echo "Production database names are forbidden for rehearsal." >&2; exit 2; }

archive="{{ remote_root }}/backup/archive/$archive_name"
[[ -f "$archive" ]] || { echo "Backup not found: $archive_name" >&2; exit 1; }

echo "Restoring $archive_name into isolated database $database_name on container $container_name."
gzip -dc "$archive" | docker exec -i "$container_name" \
  pg_restore -U ford -d "$database_name" --clean --if-exists --no-owner
echo "database_restore=completed archive=$archive_name database=$database_name container=$container_name"
