FORD_DATABASE_URL=jdbc:postgresql://{{ emme_2_private_ip }}:5432/ford_service
FORD_DATABASE_USERNAME=ford
FORD_DATABASE_PASSWORD={{ postgres_password }}
FORD_REDIS_HOST={{ emme_2_private_ip }}
FORD_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD={{ redis_password }}
FORD_MEMORY_CACHE_ENABLED=true
FORD_MEMORY_CACHE_TTL=PT24H
FORD_OPERATOR_USERNAME={{ ford_operator_username }}
FORD_OPERATOR_PASSWORD={{ ford_operator_password }}
FORD_META_APP_SECRET={{ ford_meta_app_secret }}
FORD_META_VERIFY_TOKEN={{ ford_meta_verify_token }}
FORD_MCP_ENABLED={{ (ford_mcp_enabled | default(false)) | bool | ternary('true', 'false') }}
FORD_MCP_URL={{ ford_mcp_url | default('https://your-stable-mcp-domain.example.com') }}
FORD_MCP_ENDPOINT={{ ford_mcp_endpoint | default('/mcp') }}
FORD_MCP_TOKEN={{ mcp_http_bearer_token | default('') }}
FORD_MCP_REQUEST_TIMEOUT=30s
FORD_MCP_REQUIRED_FOR_VOLATILE_INFORMATION=true
FORD_MCP_READ_ONLY_TOOL_NAMES=search_vehicles,get_vehicle,compare_vehicles,search_offers,list_promotions,get_vehicle_provenance,get_catalog_status
FORD_AI_CLOUD_ENABLED=true
FORD_AI_LOCAL_ENABLED=false
OPENAI_API_KEY={{ openai_api_key }}
FORD_OTEL_METRICS_EXPORT_ENABLED=false
FORD_OTEL_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
FORD_OTEL_SAMPLING_PROBABILITY=0.1
