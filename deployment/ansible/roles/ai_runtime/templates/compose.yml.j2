name: ford-ai-runtime

services:
  ollama:
    image: ollama/ollama@sha256:b86366bb528bbf7f1424435d165028497a5b69bf6ddb4fa5a87102e2b79f44fb
    container_name: ford-ollama
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: 20m
        max-file: "3"
    environment:
      OLLAMA_NUM_PARALLEL: "1"
      OLLAMA_MAX_LOADED_MODELS: "1"
      OLLAMA_KEEP_ALIVE: 5m
    volumes:
      - ford-ollama-models:/root/.ollama
    networks: [data_default]
    healthcheck:
      test: ["CMD", "ollama", "list"]
      interval: 15s
      timeout: 5s
      retries: 20
      start_period: 30s

  ollama-model-pull:
    image: ollama/ollama@sha256:b86366bb528bbf7f1424435d165028497a5b69bf6ddb4fa5a87102e2b79f44fb
    profiles: [model-pull]
    restart: "no"
    environment:
      OLLAMA_HOST: http://ollama:11434
    volumes:
      - ford-ollama-models:/root/.ollama
    networks: [data_default]
    depends_on:
      ollama:
        condition: service_healthy
    entrypoint: ["/bin/sh", "-c"]
    command: ["ollama pull qllama/bge-m3:q8_0"]

volumes:
  ford-ollama-models:

networks:
  data_default:
    external: true
