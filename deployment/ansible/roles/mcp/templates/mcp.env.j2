MCP_IMAGE={{ mcp_image }}
{% set secrets_provider = lookup('ansible.builtin.env', 'FORD_SECRETS_PROVIDER') | default('environment', true) %}
FORD_SECRETS_PROVIDER={{ secrets_provider }}
EMME_2_PRIVATE_IP={{ emme_2_private_ip }}
{% if secrets_provider == 'oci-vault' %}
FORD_VAULT_SECRET_OCID_POSTGRES_PASSWORD={{ lookup('ansible.builtin.env', 'FORD_VAULT_SECRET_OCID_POSTGRES_PASSWORD') | default('', true) }}
FORD_VAULT_SECRET_OCID_MCP_HTTP_BEARER_TOKEN={{ lookup('ansible.builtin.env', 'FORD_VAULT_SECRET_OCID_MCP_HTTP_BEARER_TOKEN') | default('', true) }}
{% else %}
POSTGRES_PASSWORD={{ lookup('ansible.builtin.env', 'POSTGRES_PASSWORD') | default('', true) }}
MCP_HTTP_BEARER_TOKEN={{ lookup('ansible.builtin.env', 'FORD_MCP_TOKEN') | default(lookup('ansible.builtin.env', 'FORD_MCP_API_TOKEN') | default(lookup('ansible.builtin.env', 'MCP_HTTP_BEARER_TOKEN') | default('', true), true), true) }}
{% endif %}
